{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd sadik-travels && npm ci && npm run build",
  "installCommand": "echo 'deps installed by buildCommand'",
  "outputDirectory": "sadik-travels/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
