# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# EVERY KEY MUST START WITH `VITE_`.
# Vite only copies `VITE_`-prefixed variables into the client bundle, and it
# does so at BUILD time. A key without the prefix — or one added after the
# deploy was built — arrives as `undefined` in the browser and the app falls
# back to demo mode. That is the usual reason a Firebase app works locally but
# "does not connect" on Vercel.
# ─────────────────────────────────────────────────────────────────────────────
#
# Where to get these: Firebase Console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → `firebaseConfig`.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# OPTIONAL — Realtime Database URL.
# If you set this, monthly donations are stored in the Realtime Database
# (where the original version of this app kept them). If you leave it out,
# donations live in Firestore under `donations/{YYYY-MM}/entries`.
VITE_FIREBASE_DATABASE_URL=

# OPTIONAL — first-run bootstrap.
# While the `admins` collection is empty, signing in with these exact
# credentials creates that account automatically and makes it the owner.
# Leave them blank and the sign-in screen offers "Set up the first
# administrator" instead.
VITE_SEED_ADMIN_EMAIL=
VITE_SEED_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Where to set these in production
#
# Vercel   → Project → Settings → Environment Variables
#            (add for Production AND Preview, then click Redeploy)
# Netlify  → Site configuration → Environment variables → trigger deploy
#
# Both hosts read these at BUILD time, so a redeploy is required after any
# change. To swap projects without a rebuild, edit `public/config.js` instead.
# ─────────────────────────────────────────────────────────────────────────────
