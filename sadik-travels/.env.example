# Copy this file to `.env` for local development. In production (Netlify), set
# these as Site Settings → Environment variables. They are read at RUNTIME by
# the serverless functions — no rebuild needed when you change them.

# --- Turso (libSQL) database ---
# Create a DB at https://turso.tech and copy the "libsql://..." URL.
TURSO_DB_URL=libsql://your-db.turso.io
# Create an auth token in the Turso dashboard.
TURSO_DB_AUTH_TOKEN=your-turso-auth-token

# --- JWT signing secret ---
# Generate a long random string, e.g.   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# --- Default admin (auto-seeded on first run) ---
# The first time the app starts and the admins table is empty, an admin
# account is created with these credentials. After that you can add/edit/remove
# admins from the "Admins" page and these values are ignored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
